<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PK.Dumper</RootNamespace>
    <AssemblyName>PK.Dumper</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: MelonLoader and Unity are provided by the game at runtime. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PK.Dumper.Serialization\PK.Dumper.Serialization.csproj" />
  </ItemGroup>
</Project>
