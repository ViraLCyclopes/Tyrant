<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tyrant</AssemblyName>
    <RootNamespace>Tyrant.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Tyrant.Core\Tyrant.Core.csproj" />
    <ProjectReference Include="..\..\core\Tyrant.Rpc\Tyrant.Rpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build the MelonLoader mod (net472) and ship it in <tyrant.exe folder>/dumper for 'tyrant dump install'. -->
    <ProjectReference Include="..\..\game\Tyrant.Dumper\Tyrant.Dumper.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyDumperPlugin" AfterTargets="Build">
    <ItemGroup>
      <DumperFiles Include="$(MSBuildThisFileDirectory)..\..\game\Tyrant.Dumper\bin\$(Configuration)\net472\Tyrant.Dumper*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DumperFiles)" DestinationFolder="$(OutDir)dumper" SkipUnchangedFiles="true" />
  </Target>
</Project>
