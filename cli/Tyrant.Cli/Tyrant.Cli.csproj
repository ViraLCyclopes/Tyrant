<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tyrant</AssemblyName>
    <RootNamespace>Tyrant.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Tyrant.Core\Tyrant.Core.csproj" />
    <ProjectReference Include="..\..\core\Tyrant.Rpc\Tyrant.Rpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build the MelonLoader mods (net472) and ship them in <tyrant.exe folder>/dumper for the game installer. -->
    <ProjectReference Include="..\..\game\Tyrant.Dumper\Tyrant.Dumper.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\..\game\Tyrant.Framework\Tyrant.Framework.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Target Name="CopyDumperPlugin" AfterTargets="Build">
    <ItemGroup>
      <DumperFiles Include="$(MSBuildThisFileDirectory)..\..\game\Tyrant.Dumper\bin\$(Configuration)\net472\Tyrant.Dumper*.dll" />
      <DumperFiles Include="$(MSBuildThisFileDirectory)..\..\game\Tyrant.Framework\bin\$(Configuration)\net472\Tyrant.Framework*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DumperFiles)" DestinationFolder="$(OutDir)dumper" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishDumperPlugin" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDumperFiles Include="$(OutDir)dumper\Tyrant.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedDumperFiles)" DestinationFolder="$(PublishDir)dumper" SkipUnchangedFiles="true" />
  </Target>
  <!-- Tyrant's Blender add-on, zipped as Blender's extension installer expects (manifest at the zip root). -->
  <Target Name="ZipBlenderAddon" AfterTargets="Build">
    <RemoveDir Directories="$(MSBuildThisFileDirectory)..\..\tools\blender\tyrant_blender\__pycache__" />
    <MakeDir Directories="$(OutDir)blender" />
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)..\..\tools\blender\tyrant_blender"
                  DestinationFile="$(OutDir)blender\tyrant_blender.zip" Overwrite="true" />
  </Target>
  <Target Name="PublishBlenderAddon" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)blender\tyrant_blender.zip" DestinationFolder="$(PublishDir)blender" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Tyrant.Cli.Tests" />
  </ItemGroup>
</Project>
