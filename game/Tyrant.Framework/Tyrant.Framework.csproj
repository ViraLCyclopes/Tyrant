<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Tyrant.Framework</RootNamespace>
    <AssemblyName>Tyrant.Framework</AssemblyName>
    <Version>0.2.0</Version> <!-- = FrameworkInfo.Version (FrameworkVersionTests) -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: MelonLoader (with HarmonyX) and Unity are provided by the game at runtime. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tyrant.Framework.Core\Tyrant.Framework.Core.csproj" />
  </ItemGroup>
</Project>
