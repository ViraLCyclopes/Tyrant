{
  "name": "tyrant-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "tauri": "tauri",
    "gen:types": "dotnet run --project ../cli/Tyrant.Cli/Tyrant.Cli.csproj -- rpc --emit-ts src/lib/rpc/types.gen.ts",
    "sidecar": "dotnet publish ../cli/Tyrant.Cli/Tyrant.Cli.csproj -c Release -r win-x64 --self-contained true -o src-tauri/sidecar",
    "build:app": "npm run sidecar && tauri build --config src-tauri/tauri.bundle.conf.json && node scripts/copy-setup.mjs",
    "build:portable": "npm run sidecar && tauri build --no-bundle && node scripts/portable.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "7.54.3",
    "@babylonjs/loaders": "7.54.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "26.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
